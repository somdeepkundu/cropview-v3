{
  "name": "cropview-v3",
  "version": "3.4.0",
  "private": true,
  "description": "CropView v3 — geo-tagged field crop capture. Web (GitHub Pages) + Android (Capacitor) from one index.html",
  "main": "index.html",
  "scripts": {
    "serve": "npx serve .",
    "build:www": "node scripts/build-www.mjs",
    "android": "npm run build:www && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@fontsource/comfortaa": "^5.3.0",
    "@turf/turf": "^6.5.0",
    "jszip": "^3.10.1",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
